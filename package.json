{
  "name": "sevita-app",
  "version": "1.0.0",
  "description": "Sevita Orthesis - Sistema de Gestión e Inteligencia Clínica (Web, Mobile, Desktop)",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "install-all": "pnpm install",
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @sevita/web run dev",
    "dev:mobile": "pnpm --filter @sevita/mobile run dev",
    "dev:desktop": "pnpm --filter @sevita/desktop run dev",
    "build": "pnpm -r --parallel run build",
    "build:web": "pnpm --filter @sevita/web run build",
    "build:mobile": "pnpm --filter @sevita/mobile run build",
    "build:desktop": "pnpm --filter @sevita/desktop run build",
    "test": "pnpm -r --parallel run test",
    "lint": "pnpm -r --parallel run lint",
    "type-check": "pnpm -r --parallel run type-check"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
